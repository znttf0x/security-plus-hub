root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# JSONL data banks — one long object per line; leave content untouched
[data/**]
trim_trailing_whitespace = false
insert_final_newline = false
